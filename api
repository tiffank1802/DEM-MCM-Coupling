     |      1    1.0
     |      2    2.0
     |      3    3.0
     |      4    4.0
     |      dtype: float64
     |      >>> s.mask(s > 0)
     |      0    0.0
     |      1    NaN
     |      2    NaN
     |      3    NaN
     |      4    NaN
     |      dtype: float64
     |
     |      >>> s = pd.Series(range(5))
     |      >>> t = pd.Series([True, False])
     |      >>> s.where(t, 99)
     |      0     0
     |      1    99
     |      2    99
     |      3    99
     |      4    99
     |      dtype: int64
     |      >>> s.mask(t, 99)
     |      0    99
     |      1     1
     |      2    99
     |      3    99
     |      4    99
     |      dtype: int64
     |
     |      >>> s.where(s > 1, 10)
     |      0    10
     |      1    10
     |      2    2
     |      3    3
     |      4    4
     |      dtype: int64
     |      >>> s.mask(s > 1, 10)
     |      0     0
     |      1     1
     |      2    10
     |      3    10
     |      4    10
     |      dtype: int64
     |
     |      >>> df = pd.DataFrame(np.arange(10).reshape(-1, 2), columns=["A", "B"])
     |      >>> df
