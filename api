     |      ...                    'bar': ['A', 'B', 'C', 'A', 'B', 'C'],
     |      ...                    'baz': [1, 2, 3, 4, 5, 6],
     |      ...                    'zoo': ['x', 'y', 'z', 'q', 'w', 't']})
     |      >>> df
     |          foo   bar  baz  zoo
     |      0   one   A    1    x
     |      1   one   B    2    y
     |      2   one   C    3    z
     |      3   two   A    4    q
     |      4   two   B    5    w
     |      5   two   C    6    t
     |
     |      >>> df.pivot(index='foo', columns='bar', values='baz')
     |      bar  A   B   C
     |      foo
     |      one  1   2   3
     |      two  4   5   6
     |
     |      >>> df.pivot(index='foo', columns='bar')['baz']
     |      bar  A   B   C
     |      foo
     |      one  1   2   3
     |      two  4   5   6
