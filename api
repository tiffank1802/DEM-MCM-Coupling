     |      ...                   "lev2": [1, 1, 2, 1, 1, 2],
     |      ...                   "lev3": [1, 2, 1, 2, 1, 2],
     |      ...                   "lev4": [1, 2, 3, 4, 5, 6],
     |      ...                   "values": [0, 1, 2, 3, 4, 5]})
     |      >>> df
     |          lev1 lev2 lev3 lev4 values
     |      0   1    1    1    1    0
     |      1   1    1    2    2    1
     |      2   1    2    1    3    2
     |      3   2    1    2    4    3
     |      4   2    1    1    5    4
     |      5   2    2    2    6    5
     |
     |      >>> df.pivot(index="lev1", columns=["lev2", "lev3"], values="values")
