     |
     |      >>> df = pd.DataFrame({"A": [1, 2, 3]}, index=[0, 1, 2])
     |      >>> s = pd.Series([10, 20], index=[1, 3])  # Note: index 3 doesn't exist in df
     |      >>> df["B"] = s  # Assigns by index label, not position
     |      >>> df
