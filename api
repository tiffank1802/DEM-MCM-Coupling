     |      namedtuples:
     |
     |      >>> for row in df.itertuples(name="Animal"):
     |      ...     print(row)
     |      Animal(Index='dog', num_legs=4, num_wings=0)
     |      Animal(Index='hawk', num_legs=2, num_wings=2)
