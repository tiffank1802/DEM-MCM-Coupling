     |      ... )
     |      >>> other = pd.DataFrame(
     |      ...     [[10, 20, 30, 40], [60, 70, 80, 90], [600, 700, 800, 900]],
     |      ...     columns=["A", "B", "C", "D"],
     |      ...     index=[2, 3, 4],
     |      ... )
