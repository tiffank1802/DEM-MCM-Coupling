     |      ...     [[10, 20, 30, 40], [60, 70, 80, 90], [600, 700, 800, 900]],
     |      ...     columns=["A", "B", "C", "D"],
     |      ...     index=[2, 3, 4],
     |      ... )
     |      >>> df
     |         D  B  E  A
     |      1  1  2  3  4
     |      2  6  7  8  9
