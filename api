     |      ...     index=pd.date_range("2020-01-01", "2020-01-05"),
     |      ... )
     |      >>> df
     |                  Col1  Col2  Col3
     |      2020-01-01    10    13    17
     |      2020-01-02    20    23    27
     |      2020-01-03    15    18    22
     |      2020-01-04    30    33    37
     |      2020-01-05    45    48    52
     |
