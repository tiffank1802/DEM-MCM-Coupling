     |      0    3      94      31
     |      1   29     170     115
     |      >>> df.dtypes
     |      age       int64
     |      height    int64
     |      weight    int64
     |      dtype: object
     |      >>> df.values
     |      array([[  3,  94,  31],
     |             [ 29, 170, 115]])
