     |            A     B
     |      0   1.0   NaN
     |      1   NaN   5.0
     |      2   NaN   NaN
     |      3   4.0   7.0
     |      >>> df.bfill()
     |            A     B
     |      0   1.0   5.0
     |      1   4.0   5.0
     |      2   4.0   7.0
     |      3   4.0   7.0
     |      >>> df.bfill(limit=1)
