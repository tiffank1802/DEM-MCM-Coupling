        >>> left = pd.DataFrame({"left_val": ["a", "b", "c"]}, index=[1, 5, 10])
        >>> left
           left_val
        1         a
        5         b
        10        c

        >>> right = pd.DataFrame({"right_val": [1, 2, 3, 6, 7]}, index=[1, 2, 3, 6, 7])
        >>> right
           right_val
        1          1
        2          2
        3          3
        6          6
        7          7

        >>> pd.merge_asof(left, right, left_index=True, right_index=True)
           left_val  right_val
        1         a          1
        5         b          3
        10        c          7

