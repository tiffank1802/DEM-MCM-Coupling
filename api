     |      a
     |      0    None
     |      1    None
     |      2    None
     |      3    None
     |      4    None
     |      dtype: object
     |
     |      >>> s_cat = s.astype("category")
     |      >>> s_cat.map(print)  # function called once per unique category
     |      a
     |      b
     |      c
     |      0    None
     |      1    None
     |      2    None
     |      3    None
     |      4    None
     |      dtype: object
