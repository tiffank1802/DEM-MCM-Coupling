     |      0    90
     |      1    91
     |      2    85
     |      dtype: int64
     |
     |      >>> s.pct_change()
     |      0         NaN
     |      1    0.011111
     |      2   -0.065934
     |      dtype: float64
     |
     |      >>> s.pct_change(periods=2)
     |      0         NaN
     |      1         NaN
     |      2   -0.055556
     |      dtype: float64
     |
