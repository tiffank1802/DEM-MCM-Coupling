        ...         "col1_a": [1, 0, 0],
        ...         "col1_b": [0, 1, 0],
        ...         "col2_a": [0, 1, 0],
        ...         "col2_b": [1, 0, 0],
        ...         "col2_c": [0, 0, 0],
