        0  1  0  0
        1  0  1  0
        2  0  0  1
        3  1  0  0

        >>> pd.from_dummies(df)
        0     a
        1     b
        2     c
        3     a

        >>> df = pd.DataFrame(
        ...     {
        ...         "col1_a": [1, 0, 1],
        ...         "col1_b": [0, 1, 0],
        ...         "col2_a": [0, 1, 0],
        ...         "col2_b": [1, 0, 0],
        ...         "col2_c": [0, 0, 1],
