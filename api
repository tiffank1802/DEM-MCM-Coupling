        ...     {
        ...         "key": ["a", "c", "e", "a", "c", "e"],
        ...         "lvalue": [1, 2, 3, 1, 2, 3],
        ...         "group": ["a", "a", "a", "b", "b", "b"],
        ...     }
        ... )
        >>> df1
          key  lvalue group
        0   a       1     a
        1   c       2     a
        2   e       3     a
        3   a       1     b
        4   c       2     b
        5   e       3     b

        >>> df2 = pd.DataFrame({"key": ["b", "c", "d"], "rvalue": [1, 2, 3]})
