\contentsline {figure}{\numberline {26}{\ignorespaces Correspondance entre le pas de temps de Markov $\tau $ et un tour complet du tambour tournant à $\omega = \SI {4}{rad/s}$ : $\tau = 2\pi /\omega \approx \SI {1.57}{s} = 157$ pas DEM.}}{34}{figure.caption.52}%
\contentsline {figure}{\numberline {27}{\ignorespaces Influence du pas de temps de Markov $\tau $ sur la cinétique de mélange prédite, calculée sur les données de la simulation (découpage physique, 10 cellules ; discrétisation temporelle : $\mathrm {NLT} = 2$, $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau $, $dt = \tau /10$) : RSD DEM de la teneur en petites particules (noir) et prédictions markoviennes homogènes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}. La courbe épaisse correspond à la valeur retenue $\tau = \SI {1.57}{s}$.}}{35}{figure.caption.53}%
\contentsline {figure}{\numberline {28}{\ignorespaces Étude de sensibilité au nombre de blocs d'apprentissage $\mathrm {NLT}$ par l'erreur relative sur la matrice de transition (équation~\eqref {eq:erreur_relative_nlt}, grandeur de comparaison de Doucet et al.~\blx@tocontentsinit {0}\cite {doucet2008}) : découpage physique, 10 cellules, configuration $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 1$ pas, référence $\mathrm {NLT}_{\mathrm {réf}} = 18$.}}{36}{figure.caption.54}%
\contentsline {figure}{\numberline {29}{\ignorespaces Étude de sensibilité au nombre de blocs d'apprentissage $\mathrm {NLT}$ par l'erreur relative sur la matrice de transition (équation~\eqref {eq:erreur_relative_nlt}, grandeur de comparaison de Doucet et al.~\blx@tocontentsinit {0}\cite {doucet2008}) : découpage cylindrique, 10 cellules, configuration $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 1$ pas, référence $\mathrm {NLT}_{\mathrm {réf}} = 18$.}}{37}{figure.caption.55}%
\contentsline {figure}{\numberline {30}{\ignorespaces Influence du nombre de blocs d'apprentissage $\mathrm {NLT}$ sur la qualité du modèle (découpage physique, 10 cellules, petites particules, configuration $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 1$ pas) : écart temporel RMS $|\text {Markov}-\text {DEM}|$ (gauche) et carte des écarts absolus par cellule (droite), pour $\mathrm {NLT} = 1$ (haut) et $\mathrm {NLT} = 18$, seuil de convergence de la matrice (bas).}}{38}{figure.caption.56}%
\contentsline {figure}{\numberline {31}{\ignorespaces Teneur en petites particules par cellule, référence DEM (trait continu) et prédiction markovienne homogène (marqueurs épais) superposées, une couleur par cellule, pour $\mathrm {NLT} = 1$ et $\mathrm {NLT} = 18$ (découpage physique, 10 cellules, $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 1$ pas).}}{39}{figure.caption.57}%
\contentsline {figure}{\numberline {32}{\ignorespaces Justification du choix de $\mathrm {start}$ : RSD DEM de la teneur en petites particules et prédictions markoviennes homogènes propagées depuis $t = \SI {0}{s}$, dont la matrice est apprise soit en incluant le régime transitoire ($\mathrm {start} = \SI {0}{s}$, gris), soit sur le régime permanent ($\mathrm {start} = \SI {1.57}{s}$, couleur), pour les quatre méthodes de découpage (discrétisation temporelle : $\mathrm {NLT} = 2$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 8$ pas). La zone grisée matérialise le régime transitoire ; l'écart moyen $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ est indiqué dans chaque légende.}}{40}{figure.caption.58}%
\contentsline {figure}{\numberline {33}{\ignorespaces Étude d'influence du paramètre $\mathrm {start}$ (découpage de Voronoï, 10 cellules, grandes particules, $\mathrm {NLT} = 1$, $\tau = \mathrm {step} = \SI {1.57}{s}$) : écart temporel RMS et carte des écarts absolus par cellule pour $\mathrm {start} = \SI {1.57}{s}$, \SI {3.14}{s} et \SI {15.7}{s} (temps en secondes, nombre de tours en axe supérieur).}}{42}{figure.caption.60}%
\contentsline {figure}{\numberline {34}{\ignorespaces Justification des matrices distinctes par espèce : RSD DEM de la teneur en petites particules vs prédictions markoviennes construites sans distinction d'espèce (matrice unique, gris) et avec distinction (matrices par espèce, couleur), pour les quatre méthodes de découpage (discrétisation temporelle : $\mathrm {NLT} = 2$, $\mathrm {start} = \SI {1.57}{s}$, $\mathrm {step} = \tau = \SI {1.57}{s}$, $dt = 8$ pas).}}{45}{figure.caption.66}%
