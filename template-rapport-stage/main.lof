\babel@toc {french}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Géométrie du tambour tournant : (a) vue de face avec le lit granulaire incliné, la zone active et la zone passive ; (b) vue de côté avec les dimensions caractéristiques $D = 2R$ et $L$. Le tambour tourne à $\omega = \SI {4}{rad/s}$ autour de l'axe $z$.}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Bilan des actions mécaniques sur une particule du lit granulaire : force de contact normale $\mathbf {F}_{n,ij}$ et tangentielle $\mathbf {F}_{t,ij}$ au contact inter-grains, moment de rotation $\mathbf {M}_{r,ij}$, pesanteur $m_i\mathbf {g}$ et frottement tangentiel à la paroi entraînante.}}{5}{figure.caption.5}%
\contentsline {figure}{\numberline {3}{\ignorespaces Principe de la simulation DEM}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {4}{\ignorespaces Principe de la discrétisation spatiale : le tambour est partitionné en cellules au sein desquelles la dynamique particulaire est agrégée.}}{6}{figure.caption.7}%
\contentsline {figure}{\numberline {5}{\ignorespaces Chronologie des paramètres temporels de l'apprentissage : à partir de $start$, chaque bloc fournit des paires $(t,\, t+\tau )$ échantillonnées tous les $dt$ ; les $NLT$ blocs successifs, décalés de $step$, sont moyennés (chaîne homogène) ou conservés séparément (chaîne inhomogène).}}{9}{figure.caption.11}%
\contentsline {figure}{\numberline {6}{\ignorespaces Construction de la matrice de transition à partir des déplacements inter-cellules observés dans le mélangeur discrétisé.}}{10}{figure.caption.16}%
\contentsline {figure}{\numberline {7}{\ignorespaces Principe de la chaîne inhomogène : une matrice de transition distincte est associée à chaque intervalle de temps.}}{10}{figure.caption.17}%
\contentsline {figure}{\numberline {8}{\ignorespaces Principe du découpage cartésien : la partie utile du mélangeur est segmentée en cellules parallélépipédiques de volume constant, numérotées dans l'ordre lexicographique $x \to y \to z$.}}{11}{figure.caption.19}%
\contentsline {figure}{\numberline {9}{\ignorespaces Principe du découpage cylindrique : (a) coupe transverse montrant les intervalles radiaux ($r$) et angulaires ($\theta $) ; (b) vue de côté montrant les tranches axiales ($z$). La numérotation globale suit l'ordre radial $\to $ angulaire $\to $ axial.}}{12}{figure.caption.21}%
\contentsline {figure}{\numberline {10}{\ignorespaces Attribution des particules aux cellules de Voronoï : à l'issue de la phase d'apprentissage, chaque grain est affecté à la partition dont le centre $\boldsymbol {\mu }_k$ est le plus proche au sens de la distance euclidienne (équation~\ref {eq:affectation_kmeans}).}}{14}{figure.caption.25}%
\contentsline {figure}{\numberline {11}{\ignorespaces Principe des découpages statistiques par k-moyennes : (a) découpage de Voronoï fondé sur les seules positions ; (b) découpage physique dont le vecteur de caractéristiques intègre la norme de la vitesse, séparant zone active (rapide) et zone passive (lente).}}{16}{figure.caption.29}%
\contentsline {figure}{\numberline {12}{\ignorespaces Application des découpages de Voronoï et physique aux positions issues de la simulation DEM.}}{16}{figure.caption.30}%
\contentsline {figure}{\numberline {13}{\ignorespaces Mélangeur discrétisé en cours de simulation : chaque couleur identifie une cellule (\textit {cell\_id}) du découpage. Les cellules du bas, en zone passive, sont nettement plus peuplées que celles de la surface ; les petites particules (mises en évidence) se concentrent dans certaines cellules, signature de la ségrégation.}}{17}{figure.caption.31}%
\contentsline {figure}{\numberline {14}{\ignorespaces Matrices de transition (découpage cartésien) construites séparément pour chaque espèce.}}{18}{figure.caption.32}%
\contentsline {figure}{\numberline {15}{\ignorespaces Découpage cylindrique : partitions obtenues pour différentes résolutions (de 36 à 3600 cellules) sur les 1030 particules, en vue 3D (haut) et en coupe $z$ (bas). L'indicateur $\sigma /\mu $ quantifie le déséquilibre des populations de cellules.}}{19}{figure.caption.33}%
\contentsline {figure}{\numberline {16}{\ignorespaces Matrices de transition construites à partir des données DEM pour le découpage cylindrique (10 cellules, $n_r = 2$, $n_\theta = 5$, mode à aire constante, $\tau = \SI {1.57}{s}$), séparément pour chaque espèce. La structure en blocs suit la numérotation radiale $\to $ angulaire ; la condition de stochasticité en colonne est vérifiée sur toutes les colonnes.}}{20}{figure.caption.34}%
\contentsline {figure}{\numberline {17}{\ignorespaces Découpage cylindrique : RSD de la teneur en petites particules, DEM (trait continu) vs prédictions markoviennes homogène et inhomogène ($\tau = \SI {1.57}{s}$, données DEM réelles).}}{21}{figure.caption.35}%
\contentsline {figure}{\numberline {18}{\ignorespaces Matrices de transition (découpage de Voronoï) pour chaque espèce.}}{21}{figure.caption.36}%
\contentsline {figure}{\numberline {19}{\ignorespaces Évolution temporelle du nombre de particules par cellule (vecteur d'état de type comptage).}}{22}{figure.caption.38}%
\contentsline {figure}{\numberline {20}{\ignorespaces Évolution de la teneur locale en petites particules (vecteur d'état de type ségrégation).}}{22}{figure.caption.40}%
\contentsline {figure}{\numberline {21}{\ignorespaces RSD de la concentration en petites particules : comparaison DEM / prédiction markovienne (découpage de Voronoï).}}{23}{figure.caption.42}%
\contentsline {figure}{\numberline {22}{\ignorespaces Matrices de transition (découpage physique) pour chaque espèce.}}{23}{figure.caption.43}%
\contentsline {figure}{\numberline {23}{\ignorespaces Influence de la méthode de découpage sur la prédiction (données DEM réelles) : RSD DEM vs prédiction markovienne homogène pour les quatre méthodes, à nombre de cellules identique (10 cellules) et à paramètres identiques ($\tau = \SI {1.57}{s}$, deux blocs d'apprentissage). L'écart moyen est indiqué dans le titre de chaque cadran.}}{24}{figure.caption.44}%
\contentsline {figure}{\numberline {24}{\ignorespaces Évolution de la teneur en petites particules : découpage physique, chaîne inhomogène.}}{26}{figure.caption.47}%
\contentsline {figure}{\numberline {25}{\ignorespaces RSD de la concentration en petites particules : DEM vs.\ Markov homogène et inhomogène (découpage physique).}}{26}{figure.caption.48}%
\contentsline {figure}{\numberline {26}{\ignorespaces Correspondance entre le pas de temps de Markov $\tau $ et un tour complet du tambour tournant à $\omega = \SI {4}{rad/s}$ : $\tau = 2\pi /\omega \approx \SI {1.57}{s} = 157$ pas DEM.}}{30}{figure.caption.54}%
\contentsline {figure}{\numberline {27}{\ignorespaces Influence du pas de temps de Markov $\tau $ sur la cinétique de mélange prédite, calculée sur les données DEM (découpage physique, 10 cellules) : RSD DEM de la teneur en petites particules (noir) et prédictions markoviennes homogènes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}. La courbe épaisse correspond à la valeur retenue $\tau = \SI {1.57}{s}$.}}{31}{figure.caption.55}%
\contentsline {figure}{\numberline {28}{\ignorespaces Étude complémentaire de l'influence de $\tau $ (découpage physique, 30 cellules) : RSD de la DEM (noir) et prédictions markoviennes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}.}}{32}{figure.caption.56}%
\contentsline {figure}{\numberline {29}{\ignorespaces Étude de sensibilité au nombre de blocs d'apprentissage $NLT$, calculée sur les données DEM (découpage physique, 10 cellules, $\tau = step = \SI {1.57}{s}$) : erreur moyenne $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ sur la fenêtre de prédiction.}}{33}{figure.caption.57}%
\contentsline {figure}{\numberline {30}{\ignorespaces Influence du nombre de blocs d'apprentissage $NLT$ sur la qualité du modèle (découpage physique, 10 cellules, $\tau = \SI {1.57}{s}$) : écart temporel RMS $|\text {Markov}-\text {DEM}|$ (gauche) et carte des écarts absolus par cellule (droite) (axes de ces figures d'archive en centièmes de seconde).}}{34}{figure.caption.58}%
\contentsline {figure}{\numberline {31}{\ignorespaces Teneur en petites particules par cellule, DEM (traits pleins) vs Markov (pointillés), pour $NLT = 1$ et $NLT = 50$ (découpage physique, 10 cellules).}}{35}{figure.caption.59}%
\contentsline {figure}{\numberline {32}{\ignorespaces Justification du choix de $start$ : RSD DEM de la teneur en petites particules et prédictions markoviennes homogènes propagées depuis $t = \SI {0}{s}$, dont la matrice est apprise soit en incluant le régime transitoire ($start = \SI {0}{s}$, gris), soit sur le régime permanent ($start = \SI {1.57}{s}$, couleur), pour les quatre méthodes de découpage. La zone grisée matérialise le régime transitoire ; l'écart moyen $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ est indiqué dans chaque légende.}}{36}{figure.caption.60}%
\contentsline {figure}{\numberline {33}{\ignorespaces Étude d'influence du paramètre $start$ (découpage de Voronoï, 10 cellules, grandes particules, $NLT = 1$, $\tau = step = \SI {1.57}{s}$) : écart temporel RMS et carte des écarts absolus par cellule pour $start = \SI {1.57}{s}$, \SI {3.14}{s} et \SI {15.7}{s} (axes de ces figures d'archive en centièmes de seconde).}}{38}{figure.caption.62}%
\contentsline {figure}{\numberline {34}{\ignorespaces Étude de sensibilité à l'écart entre blocs $step$, calculée sur les données DEM (découpage physique, 10 cellules, $NLT = 3$, $\tau = \SI {1.57}{s}$) : erreur moyenne $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ sur la fenêtre de prédiction. La ligne pointillée marque la valeur retenue $step = \tau = \SI {1.57}{s}$.}}{40}{figure.caption.64}%
