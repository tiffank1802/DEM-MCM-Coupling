\babel@toc {french}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Géométrie du tambour tournant : (a) vue de face avec le lit granulaire incliné, (b) vue de côté . Le tambour de dimensions caractéristiques $D = 2R=0.1m$ et $L=0.1m$ tourne à $\omega = \SI {4}{rad/s}$ autour de l'axe $z$.}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Post-traitement 3D du matériau de référence : les 1030 particules aux diamètres réels (petites 4 mm en bleu, grandes 8 mm en rouge), (a) à l'état initial où les espèces sont séparées et (b) après un tour de tambour, lit en écoulement.}}{4}{figure.caption.5}%
\contentsline {figure}{\numberline {3}{\ignorespaces Bilan des actions mécaniques sur une particule de la zone d'équilibre du granulaire : force de contact normale $\mathbf {F}_{n,ij}$ et tangentielle $\mathbf {F}_{t,ij}$ au contact inter-grains, moment de rotation $\mathbf {M}_{r,ij}$, pesanteur $m_i\mathbf {g}$ et frottement tangentiel à la paroi entraînante.}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {4}{\ignorespaces Principe de la discrétisation spatiale : le tambour est partitionné en cellules au sein desquelles la dynamique particulaire est agrégée.}}{6}{figure.caption.7}%
\contentsline {figure}{\numberline {5}{\ignorespaces Algorithme de construction et d'exploitation du modèle de Markov : les données DEM servent d'abord à ajuster le partitionneur sur le régime permanent, puis à labelliser chaque particule à chaque instant ; les vecteurs d'état de comptage qui en découlent alimentent l'apprentissage de la ou des matrices de transition, la prédiction, et enfin la validation par confrontation à la référence DEM.}}{7}{figure.caption.8}%
\contentsline {figure}{\numberline {6}{\ignorespaces Chronologie des paramètres temporels de l'apprentissage : à partir de $start$, chaque bloc fournit des paires $(t,\, t+\tau )$ échantillonnées tous les $dt$ ; les $NLT$ blocs successifs, décalés de $step$, sont moyennés (chaîne homogène) ou conservés séparément (chaîne inhomogène).}}{10}{figure.caption.12}%
\contentsline {figure}{\numberline {7}{\ignorespaces Construction de la matrice de transition à partir des déplacements inter-cellules observés dans le mélangeur discrétisé.}}{11}{figure.caption.17}%
\contentsline {figure}{\numberline {8}{\ignorespaces Principe de la chaîne inhomogène : une matrice de transition distincte est associée à chaque intervalle de temps.}}{11}{figure.caption.18}%
\contentsline {figure}{\numberline {9}{\ignorespaces Principe du découpage cartésien : la partie utile du mélangeur est segmentée en cellules parallélépipédiques de volume constant, numérotées dans l'ordre lexicographique $x \to y \to z$.}}{13}{figure.caption.20}%
\contentsline {figure}{\numberline {10}{\ignorespaces Principe du découpage cylindrique : (a) coupe transverse montrant les intervalles radiaux ($r$) et angulaires ($\theta $) ; (b) vue de côté montrant les tranches axiales ($z$). La numérotation globale suit l'ordre radial $\to $ angulaire $\to $ axial.}}{14}{figure.caption.22}%
\contentsline {figure}{\numberline {11}{\ignorespaces Principe des découpages statistiques par k-moyennes : (a) découpage de Voronoï fondé sur les seules positions ; (b) découpage physique dont le vecteur de caractéristiques intègre la norme de la vitesse.}}{16}{figure.caption.29}%
\contentsline {figure}{\numberline {12}{\ignorespaces Espace des caractéristiques du découpage physique : positions des 1030 particules colorées par la norme de leur vitesse, (a) cumulées sur la fenêtre d'apprentissage (cinq tours du régime permanent) et (b) à un instant de la phase de prédiction. La zone active de surface (vitesses élevées, teintes claires) se distingue nettement de la zone passive du cœur du lit (vitesses faibles, teintes sombres) : c'est ce contraste que la quatrième caractéristique $\|\mathbf {v}_p\|$ permet de séparer.}}{17}{figure.caption.30}%
\contentsline {figure}{\numberline {13}{\ignorespaces Mélangeur discrétisé en cours de simulation : chaque couleur identifie une cellule (\textit {cell\_id}) du découpage. Les cellules du bas, en zone passive, sont nettement plus peuplées que celles de la surface ; les petites particules (mises en évidence) se concentrent dans certaines cellules, signature de la ségrégation.}}{18}{figure.caption.31}%
\contentsline {figure}{\numberline {14}{\ignorespaces Post-traitement 3D du découpage cartésien ($5 \times 2 \times 1$, 10 cellules) : particules aux diamètres réels colorées par le label \textit {cell\_id} de leur cellule, à $t = \SI {1.57}{s}$.}}{19}{figure.caption.32}%
\contentsline {figure}{\numberline {15}{\ignorespaces Matrices de transition (découpage cartésien) construites séparément pour chaque espèce.}}{20}{figure.caption.33}%
\contentsline {figure}{\numberline {16}{\ignorespaces Découpage cylindrique : partitions obtenues pour différentes résolutions (de 36 à 3600 cellules) sur les 1030 particules, en vue 3D (haut) et en coupe $z$ (bas). L'indicateur $\sigma /\mu $ quantifie le déséquilibre des populations de cellules.}}{21}{figure.caption.34}%
\contentsline {figure}{\numberline {17}{\ignorespaces Post-traitement 3D du découpage cylindrique ($n_r = 2$, $n_\theta = 5$, 10 cellules) : particules aux diamètres réels colorées par le label \textit {cell\_id} de leur cellule, à $t = \SI {1.57}{s}$.}}{21}{figure.caption.35}%
\contentsline {figure}{\numberline {18}{\ignorespaces Matrices de transition construites à partir des données DEM pour le découpage cylindrique (10 cellules, $n_r = 2$, $n_\theta = 5$, mode à aire constante, $\tau = \SI {1.57}{s}$), séparément pour chaque espèce. La structure en blocs suit la numérotation radiale $\to $ angulaire ; la condition de stochasticité en colonne est vérifiée sur toutes les colonnes.}}{22}{figure.caption.36}%
\contentsline {figure}{\numberline {19}{\ignorespaces Découpage cylindrique : RSD de la teneur en petites particules, DEM (trait continu) vs prédictions markoviennes homogène et inhomogène ($\tau = \SI {1.57}{s}$, données DEM réelles).}}{23}{figure.caption.37}%
\contentsline {figure}{\numberline {20}{\ignorespaces Post-traitement 3D du découpage de Voronoï (10 cellules) : particules aux diamètres réels colorées par le label \textit {cell\_id} de leur cellule, à $t = \SI {1.57}{s}$.}}{24}{figure.caption.38}%
\contentsline {figure}{\numberline {21}{\ignorespaces Matrices de transition (découpage de Voronoï) pour chaque espèce.}}{24}{figure.caption.39}%
\contentsline {figure}{\numberline {22}{\ignorespaces Évolution temporelle du nombre de particules par cellule (vecteur d'état de type comptage).}}{25}{figure.caption.41}%
\contentsline {figure}{\numberline {23}{\ignorespaces Évolution de la teneur locale en petites particules (vecteur d'état de type ségrégation).}}{25}{figure.caption.43}%
\contentsline {figure}{\numberline {24}{\ignorespaces RSD de la concentration en petites particules : comparaison DEM / prédiction markovienne (découpage de Voronoï).}}{26}{figure.caption.45}%
\contentsline {figure}{\numberline {25}{\ignorespaces Post-traitement 3D du découpage physique (10 cellules) : particules aux diamètres réels colorées par le label \textit {cell\_id} de leur cellule, à $t = \SI {1.57}{s}$. Les cellules suivent les iso-vitesses de l'écoulement.}}{26}{figure.caption.46}%
\contentsline {figure}{\numberline {26}{\ignorespaces Contenu d'une cellule du découpage physique (cellule la plus peuplée, $t = \SI {1.57}{s}$) : les particules de la cellule sont mises en évidence (petites en bleu, grandes en rouge), le reste du lit est estompé. Le dénombrement par espèce donne directement la teneur locale de la cellule.}}{27}{figure.caption.47}%
\contentsline {figure}{\numberline {27}{\ignorespaces Matrices de transition (découpage physique) pour chaque espèce.}}{28}{figure.caption.48}%
\contentsline {figure}{\numberline {28}{\ignorespaces Influence de la méthode de découpage sur la prédiction (données DEM réelles) : RSD DEM vs prédiction markovienne homogène pour les quatre méthodes, à nombre de cellules identique (10 cellules) et à paramètres identiques ($\tau = \SI {1.57}{s}$, deux blocs d'apprentissage). L'écart moyen est indiqué dans le titre de chaque cadran.}}{29}{figure.caption.49}%
\contentsline {figure}{\numberline {29}{\ignorespaces Évolution de la teneur en petites particules : découpage physique, chaîne inhomogène.}}{31}{figure.caption.52}%
\contentsline {figure}{\numberline {30}{\ignorespaces RSD de la concentration en petites particules : DEM vs.\ Markov homogène et inhomogène (découpage physique).}}{31}{figure.caption.53}%
\contentsline {figure}{\numberline {31}{\ignorespaces Correspondance entre le pas de temps de Markov $\tau $ et un tour complet du tambour tournant à $\omega = \SI {4}{rad/s}$ : $\tau = 2\pi /\omega \approx \SI {1.57}{s} = 157$ pas DEM.}}{35}{figure.caption.59}%
\contentsline {figure}{\numberline {32}{\ignorespaces Influence du pas de temps de Markov $\tau $ sur la cinétique de mélange prédite, calculée sur les données DEM (découpage physique, 10 cellules) : RSD DEM de la teneur en petites particules (noir) et prédictions markoviennes homogènes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}. La courbe épaisse correspond à la valeur retenue $\tau = \SI {1.57}{s}$.}}{36}{figure.caption.60}%
\contentsline {figure}{\numberline {33}{\ignorespaces Étude complémentaire de l'influence de $\tau $ (découpage physique, 30 cellules) : RSD de la DEM (noir) et prédictions markoviennes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}.}}{37}{figure.caption.61}%
\contentsline {figure}{\numberline {34}{\ignorespaces Étude de sensibilité au nombre de blocs d'apprentissage $NLT$, calculée sur les données DEM (découpage physique, 10 cellules, $\tau = step = \SI {1.57}{s}$) : erreur moyenne $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ sur la fenêtre de prédiction.}}{38}{figure.caption.62}%
\contentsline {figure}{\numberline {35}{\ignorespaces Influence du nombre de blocs d'apprentissage $NLT$ sur la qualité du modèle (découpage physique, 10 cellules, $\tau = \SI {1.57}{s}$) : écart temporel RMS $|\text {Markov}-\text {DEM}|$ (gauche) et carte des écarts absolus par cellule (droite) (axes de ces figures d'archive en centièmes de seconde).}}{39}{figure.caption.63}%
\contentsline {figure}{\numberline {36}{\ignorespaces Teneur en petites particules par cellule, DEM (traits pleins) vs Markov (pointillés), pour $NLT = 1$ et $NLT = 50$ (découpage physique, 10 cellules).}}{40}{figure.caption.64}%
\contentsline {figure}{\numberline {37}{\ignorespaces Justification du choix de $start$ : RSD DEM de la teneur en petites particules et prédictions markoviennes homogènes propagées depuis $t = \SI {0}{s}$, dont la matrice est apprise soit en incluant le régime transitoire ($start = \SI {0}{s}$, gris), soit sur le régime permanent ($start = \SI {1.57}{s}$, couleur), pour les quatre méthodes de découpage. La zone grisée matérialise le régime transitoire ; l'écart moyen $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ est indiqué dans chaque légende.}}{41}{figure.caption.65}%
\contentsline {figure}{\numberline {38}{\ignorespaces Étude d'influence du paramètre $start$ (découpage de Voronoï, 10 cellules, grandes particules, $NLT = 1$, $\tau = step = \SI {1.57}{s}$) : écart temporel RMS et carte des écarts absolus par cellule pour $start = \SI {1.57}{s}$, \SI {3.14}{s} et \SI {15.7}{s} (axes de ces figures d'archive en centièmes de seconde).}}{43}{figure.caption.67}%
\contentsline {figure}{\numberline {39}{\ignorespaces Étude de sensibilité à l'écart entre blocs $step$, calculée sur les données DEM (découpage physique, 10 cellules, $NLT = 3$, $\tau = \SI {1.57}{s}$) : erreur moyenne $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ sur la fenêtre de prédiction. La ligne pointillée marque la valeur retenue $step = \tau = \SI {1.57}{s}$.}}{45}{figure.caption.69}%
\contentsline {figure}{\numberline {40}{\ignorespaces Justification des matrices distinctes par espèce : RSD DEM de la teneur en petites particules vs prédictions markoviennes construites sans distinction d'espèce (matrice unique, gris) et avec distinction (matrices par espèce, couleur), pour les quatre méthodes de découpage.}}{46}{figure.caption.70}%
\contentsline {figure}{\numberline {41}{\ignorespaces Illustration de la teneur locale en petites particules $c_i$ dans un découpage cartésien : rapport du nombre de petites particules (bleu) au nombre total de particules de la cellule. Les écarts de teneur entre cellules signent la ségrégation.}}{47}{figure.caption.72}%
