\contentsline {figure}{\numberline {1}{\ignorespaces Géométrie du tambour tournant : (a) vue de face avec le lit granulaire incliné, (b) vue de côté . Le tambour de dimensions caractéristiques $D = 2R=0.1m$ et $L=0.1m$ tourne à $\omega = \SI {4}{rad/s}$ autour de l'axe $z$.}}{4}{figure.caption.5}%
\contentsline {figure}{\numberline {2}{\ignorespaces Matériau de référence : les 1030 particules aux diamètres réels (petites 4 mm en bleu, grandes 8 mm en rouge), (a) à l'état initial où les espèces sont séparées et (b) après un tour de tambour, lit en écoulement.}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {3}{\ignorespaces Bilan des actions mécaniques sur une particule de la zone d'équilibre du granulaire : force de contact normale $\mathbf {F}_{n,ij}$ et tangentielle $\mathbf {F}_{t,ij}$ au contact inter-grains, moment de rotation $\mathbf {M}_{r,ij}$, pesanteur $m_i\mathbf {g}$ .}}{6}{figure.caption.7}%
\contentsline {figure}{\numberline {4}{\ignorespaces Mélangeur non discrétisé à des instants distincts (particules aux diamètres réels, petites 4 mm en bleu, grandes 8 mm en rouge) : état initial séparé, lit en écoulement ($t = \SI {1.57}{s}$), mélange avancé ($t = \SI {10}{s}$) et régime tardif ($t = \SI {30}{s}$).}}{7}{figure.caption.8}%
\contentsline {figure}{\numberline {5}{\ignorespaces Mélangeur discrétisé (découpage de Voronoï, 10 cellules) aux mêmes instants : chaque particule porte la couleur de la cellule qui la contient ; la dynamique particulaire est agrégée à l'échelle de ces cellules.}}{8}{figure.caption.9}%
\contentsline {figure}{\numberline {6}{\ignorespaces Algorithme de construction et d'exploitation du modèle de Markov : les données DEM servent d'abord à ajuster la méthode de maillage sur le régime permanent, puis à labelliser chaque particule à chaque instant ; les vecteurs d'état de comptage qui en découlent alimentent l'apprentissage de la ou des matrices de transition, la prédiction, et enfin la validation par confrontation à la référence DEM.}}{9}{figure.caption.10}%
\contentsline {figure}{\numberline {7}{\ignorespaces Chronologie des paramètres temporels de l'apprentissage : à partir de $start$, chaque bloc fournit des paires $(t,\, t+\tau )$ échantillonnées tous les $dt$ ; les $NLT$ blocs successifs, décalés de $step$, sont moyennés (chaîne homogène) ou conservés séparément (chaîne inhomogène).}}{12}{figure.caption.14}%
\contentsline {figure}{\numberline {8}{\ignorespaces Découpage cartésien représenté dans le repère du tambour et dans le repère du lit. Ce dernier est obtenu par translation au barycentre et rotation selon les directions principales du lit.}}{14}{figure.caption.20}%
\contentsline {figure}{\numberline {9}{\ignorespaces Principe du découpage cartésien : la partie utile du mélangeur est segmentée en cellules parallélépipédiques de volume constant, numérotées dans l'ordre lexicographique $x \to y \to z$.}}{14}{figure.caption.22}%
\contentsline {figure}{\numberline {10}{\ignorespaces Principe du découpage cylindrique : (a) coupe transverse montrant les intervalles radiaux ($r$) et angulaires ($\theta $) ; (b) vue de côté montrant les tranches axiales ($z$). La numérotation globale suit l'ordre radial $\to $ angulaire $\to $ axial.}}{15}{figure.caption.24}%
\contentsline {figure}{\numberline {11}{\ignorespaces Principe des découpages statistiques par k-moyennes : (a) découpage de Voronoï fondé sur les seules positions ; (b) découpage physique dont le vecteur de caractéristiques intègre la norme de la vitesse.}}{18}{figure.caption.31}%
\contentsline {figure}{\numberline {12}{\ignorespaces Différence entre les découpages de Voronoï et physique : le premier utilise les positions seules, tandis que le second intègre la norme de la vitesse.}}{18}{figure.caption.32}%
\contentsline {figure}{\numberline {13}{\ignorespaces Découpage cartésien (10 bandes dans le repère du lit) à $t = \SI {1.57}{s}$.}}{20}{figure.caption.33}%
\contentsline {figure}{\numberline {14}{\ignorespaces Matrices de transition du découpage cartésien (10 bandes dans le repère du lit ; discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas).}}{20}{figure.caption.34}%
\contentsline {figure}{\numberline {15}{\ignorespaces Évolution de la teneur locale en petites particules au cours du temps – découpage cartésien (10 bandes, Markov homogène, $nlt=2$, $start=1{,}57$s, $step=\tau =1{,}57$s, $dt=8$ pas).}}{21}{figure.caption.35}%
\contentsline {figure}{\numberline {16}{\ignorespaces Découpage cylindrique (10 secteurs angulaires dans le repère du lit) }}{21}{figure.caption.36}%
\contentsline {figure}{\numberline {17}{\ignorespaces Matrices de transition du découpage cylindrique (discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas), }}{22}{figure.caption.37}%
\contentsline {figure}{\numberline {18}{\ignorespaces Évolution de la teneur locale en petites particules au cours du temps – découpage cylindrique }}{23}{figure.caption.38}%
\contentsline {figure}{\numberline {19}{\ignorespaces Découpage de Voronoï (10 cellules) }}{23}{figure.caption.39}%
\contentsline {figure}{\numberline {20}{\ignorespaces Matrices de transition du découpage de Voronoï (discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas) }}{24}{figure.caption.40}%
\contentsline {figure}{\numberline {21}{\ignorespaces Évolution de la teneur locale en petites particules au cours du temps – découpage Voronoï(10 cellules)}}{24}{figure.caption.41}%
\contentsline {figure}{\numberline {22}{\ignorespaces Découpage physique (10 cellules) à $t = \SI {1.57}{s}$.}}{25}{figure.caption.42}%
\contentsline {figure}{\numberline {23}{\ignorespaces Matrices de transition du découpage physique (discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas)}}{25}{figure.caption.43}%
\contentsline {figure}{\numberline {24}{\ignorespaces Évolution de la teneur locale en petites particules au cours du temps – découpage physique }}{26}{figure.caption.44}%
\contentsline {figure}{\numberline {25}{\ignorespaces Influence de la méthode de discrétisation spatiale sur la prédiction : RSD DEM vs prédiction markovienne homogène pour les quatre méthodes, à nombre de cellules identique (10 cellules) et à configuration identique ($nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas). }}{27}{figure.caption.45}%
\contentsline {figure}{\numberline {26}{\ignorespaces Approche globale sur les courbes de teneur : écart absolu moyen de teneur par cellule entre la prédiction markovienne homogène et la référence DEM, pour les quatre méthodes de découpage à nombre de cellules identique (10 cellules, configuration $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas).}}{28}{figure.caption.47}%
\contentsline {figure}{\numberline {27}{\ignorespaces RSD de la teneur en petites particules our les quatre méthodes, 10 cellules chacune ($start = \SI {1.57}{s}$, $\tau = \SI {1.57}{s}$, $dt = 8$ pas ; chaîne inhomogène : blocs espacés de 7 tours, soit 5 matrices).}}{29}{figure.caption.48}%
\contentsline {figure}{\numberline {28}{\ignorespaces Correspondance entre le pas de temps de Markov $\tau $ et un tour complet du tambour tournant à $\omega = \SI {4}{rad/s}$ : $\tau = 2\pi /\omega \approx \SI {1.57}{s} = 157$ pas DEM.}}{32}{figure.caption.52}%
\contentsline {figure}{\numberline {29}{\ignorespaces Influence du pas de temps de Markov $\tau $ sur la cinétique de mélange prédite, calculée sur les données de la simulation (découpage physique, 10 cellules ; discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau $, $dt = \tau /10$) : RSD DEM de la teneur en petites particules (noir) et prédictions markoviennes homogènes pour $\tau $ de \SI {0.1}{s} à \SI {10}{s}. La courbe épaisse correspond à la valeur retenue $\tau = \SI {1.57}{s}$.}}{33}{figure.caption.53}%
\contentsline {figure}{\numberline {30}{\ignorespaces Étude de sensibilité au nombre de blocs d'apprentissage $NLT$ par l'erreur relative sur la matrice de transition (équation~\eqref {eq:erreur_relative_nlt}, grandeur de comparaison de Doucet et al.~\blx@tocontentsinit {0}\cite {doucet2008}) : découpage physique, 10 cellules, configuration $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 1$ pas, référence $NLT_{\mathrm {réf}} = 18$.}}{35}{figure.caption.54}%
\contentsline {figure}{\numberline {31}{\ignorespaces Influence du nombre de blocs d'apprentissage $NLT$ sur la qualité du modèle (découpage physique, 10 cellules, petites particules, configuration $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 1$ pas) : écart temporel RMS $|\text {Markov}-\text {DEM}|$ (gauche) et carte des écarts absolus par cellule (droite), pour $NLT = 1$ (haut) et $NLT = 18$, seuil de convergence de la matrice (bas).}}{36}{figure.caption.55}%
\contentsline {figure}{\numberline {32}{\ignorespaces Teneur en petites particules par cellule, référence DEM (trait continu) et prédiction markovienne homogène (marqueurs épais) superposées, une couleur par cellule, pour $NLT = 1$ et $NLT = 18$ (découpage physique, 10 cellules, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 1$ pas).}}{37}{figure.caption.56}%
\contentsline {figure}{\numberline {33}{\ignorespaces Justification du choix de $start$ : RSD DEM de la teneur en petites particules et prédictions markoviennes homogènes propagées depuis $t = \SI {0}{s}$, dont la matrice est apprise soit en incluant le régime transitoire ($start = \SI {0}{s}$, gris), soit sur le régime permanent ($start = \SI {1.57}{s}$, couleur), pour les quatre méthodes de découpage (discretisation temporelle: $nlt = 2$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas). La zone grisée matérialise le régime transitoire ; l'écart moyen $|\mathrm {RSD}_{\text {Markov}} - \mathrm {RSD}_{\text {DEM}}|$ est indiqué dans chaque légende.}}{38}{figure.caption.57}%
\contentsline {figure}{\numberline {34}{\ignorespaces Étude d'influence du paramètre $start$ (découpage de Voronoï, 10 cellules, grandes particules, $NLT = 1$, $\tau = step = \SI {1.57}{s}$) : écart temporel RMS et carte des écarts absolus par cellule pour $start = \SI {1.57}{s}$, \SI {3.14}{s} et \SI {15.7}{s} (temps en secondes, nombre de tours en axe supérieur).}}{40}{figure.caption.59}%
\contentsline {figure}{\numberline {35}{\ignorespaces Conformité de la matrice de transition selon le raffinage temporel $dt$ : nombre de colonnes contenant des \textit {NaN}, pour les découpages géométriques dans les deux repères de labélisation et pour les découpages statistiques ($nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$).}}{42}{figure.caption.61}%
\contentsline {figure}{\numberline {36}{\ignorespaces Justification des matrices distinctes par espèce : RSD DEM de la teneur en petites particules vs prédictions markoviennes construites sans distinction d'espèce (matrice unique, gris) et avec distinction (matrices par espèce, couleur), pour les quatre méthodes de découpage (discretisation temporelle: $nlt = 2$, $start = \SI {1.57}{s}$, $step = \tau = \SI {1.57}{s}$, $dt = 8$ pas).}}{44}{figure.caption.63}%
\contentsline {figure}{\numberline {37}{\ignorespaces Illustration de la teneur locale en petites particules $c_i$ dans un découpage cartésien : rapport du nombre de petites particules (bleu) au nombre total de particules de la cellule. Les écarts de teneur entre cellules signent la ségrégation.}}{45}{figure.caption.65}%
